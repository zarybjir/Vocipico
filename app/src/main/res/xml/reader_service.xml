<?xml version="1.0" encoding="utf-8"?>
<!-- Výchozí nastavení služby. Za běhu se upravuje podle nastavení v appce
     (odebírá se jen to, co je potřeba — šetří to baterii i výkon). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackSpoken"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:isAccessibilityTool="true"
    android:canPerformGestures="false"
    android:description="@string/service_description"
    android:notificationTimeout="150"
    android:settingsActivity="cz.prectimito.app.MainActivity" />
